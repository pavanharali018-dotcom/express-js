<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quora Posts</title>
</head>
<body>
    <h1>Quora Posts</h1>
    <% for(post of posts){ %>
       <div>
        <h3> Username:@<%=post.username%></h3>
        <h3>Content:<%= post.content %></h3>
       </div>

    <%} %>
       
</body>
</html>